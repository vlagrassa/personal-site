{%- if not quick_links_gap %}
{%- set quick_links_gap = "3" %}
{%- endif %}


{%- macro render_quick_link_content(id, size=28, label="", adjust_icon_x="0px", adjust_icon_y="0px") %}
<div style="position: relative;">

  {# Hexagon background #}
  <svg id="{{ id }}" class="hex-button" viewBox="-12 -12 24 24" width="{{ size }}px" height="{{ size }}px" >
    <path
      class="hex-button-bg"
      d="M7.391,-5.733C8.253,-5.064,8.512,-4.615,8.66,-3.534C8.808,-2.453,8.808,2.453,8.66,3.534C8.512,4.615,8.253,5.064,7.391,5.733C6.528,6.402,2.28,8.855,1.27,9.267C0.259,9.679,-0.259,9.679,-1.27,9.267C-2.28,8.855,-6.528,6.402,-7.391,5.733C-8.253,5.064,-8.512,4.615,-8.66,3.534C-8.808,2.453,-8.808,-2.453,-8.66,-3.534C-8.512,-4.615,-8.253,-5.064,-7.391,-5.733C-6.528,-6.402,-2.28,-8.855,-1.27,-9.267C-0.259,-9.679,0.259,-9.679,1.27,-9.267C2.28,-8.855,6.528,-6.402,7.391,-5.733Z"
      stroke="var(--color-hex-button)"
      stroke-width="{{ 20 / size }}"
    />
    <path
      class="hex-button-outline"
      d="M8.941,-6.838C9.984,-6.04,10.223,-5.627,10.392,-4.324C10.562,-3.022,10.562,3.022,10.392,4.324C10.223,5.627,9.984,6.04,8.941,6.838C7.898,7.635,2.663,10.658,1.451,11.162C0.239,11.667,-0.239,11.667,-1.451,11.162C-2.663,10.658,-7.898,7.635,-8.941,6.838C-9.984,6.04,-10.223,5.627,-10.392,4.324C-10.562,3.022,-10.562,-3.022,-10.392,-4.324C-10.223,-5.627,-9.984,-6.04,-8.941,-6.838C-7.898,-7.635,-2.663,-10.658,-1.451,-11.162C-0.239,-11.667,0.239,-11.667,1.451,-11.162C2.663,-10.658,7.898,-7.635,8.941,-6.838Z"
      stroke-width="{{ 20 / size }}"
    />
  </svg>

  {# Icon image #}
  <div style="position: absolute; top: 50%; left: 50%; transform: translate(calc(-50% + {{ adjust_icon_x }}), calc(-50% + {{ adjust_icon_y }}));">
    {{ caller() }}
  </div>
</div>

{# Label #}
<div class="px-2 d-flex flex-column justify-content-around">
  <div>
    {{ render_lang_object( label ) }}
  </div>
</div>

{# Spacing #}
<div style="width: 16px"></div>
{%- endmacro -%}

{%- macro render_quick_link_button(id, size=28, title="", label="", class="", adjust_icon_x="0px", adjust_icon_y="0px", onclick="") -%}
<button title="{{ title }}" class="bg-transparent border-0 p-0 hex-button-labeled {{ class }}" onclick="{{ onclick }}">
  {%- with wrapped = caller() -%}
  {%- call render_quick_link_content(id, size=size, label=label, adjust_icon_x=adjust_icon_x, adjust_icon_y=adjust_icon_y) -%}
    {{ wrapped }}
  {%- endcall -%}
  {%- endwith -%}
</button>
{%- endmacro -%}

{%- macro render_quick_link_anchor(id, size=28, title="", label="", class="", adjust_icon_x="0px", adjust_icon_y="0px", href="") -%}
<a title="{{ title }}" class="bg-transparent border-0 p-0 hex-button-labeled {{ class }}" href="{{ href }}">
  {%- with wrapped = caller() -%}
  {%- call render_quick_link_content(id, size=size, label=label, adjust_icon_x=adjust_icon_x, adjust_icon_y=adjust_icon_y) -%}
    {{ wrapped }}
  {%- endcall -%}
  {%- endwith -%}
</a>
{%- endmacro -%}


{# Icons from Google Material Icons, downloaded as SVGs with weight 300 and size 16px #}
<span class="d-flex flex-wrap justify-content-center gap-{{ quick_links_gap }} row-gap-2">

  {% call render_quick_link_button(
    "quick-links-resume",
    title   = "Download résumé",
    label   = config.TEXT['sidebar.resume'],
    adjust_icon_y = "-1px",
  ) %}
    {# Icon: file_save #}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" width="16px" height="16px" fill="var(--color-off-white)">
      <path d="M732-134.23 861.77-264 825-300.77l-67 67V-398h-52v164.23l-67-67L602.23-264 732-134.23ZM598-10v-52h268v52H598ZM266.31-154q-25.54 0-44.92-19.39Q202-192.77 202-218.31v-571.38q0-25.54 19.39-44.92Q240.77-854 266.31-854H576l182 182v194.31h-52V-634H538v-168H266.31q-4.62 0-8.46 3.85-3.85 3.84-3.85 8.46v571.38q0 4.62 3.85 8.46 3.84 3.85 8.46 3.85h264v52h-264ZM254-206v-596 596Z"/>
    </svg>
  {% endcall %}

  {% call render_quick_link_anchor(
    "quick-links-contact",
    title   = "Send email to connect@vlagrassa.dev",
    label   = config.TEXT['sidebar.contact'],
    href    = "mailto:connect@vlagrassa.dev",
    class   = "flex-row-reverse",
    adjust_icon_x = "1px",
    adjust_icon_y = "1px",
  ) %}
    {# Icon: outgoing_mail #}
    <svg xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="var(--color-off-white)">
      <path d="M723-206.23 686.23-243l65.62-67H586v-52h165.85l-65.62-67L723-465.77 849.77-336 723-206.23ZM170.31-298q-26.53 0-45.42-18.89T106-362.31v-379.38q0-26.53 18.89-45.42T170.31-806h474.95q27.26 0 46 18.89T710-741.69l1 174.15q2.5.77 5 1.16 2.5.38 5 .38-16.5 1-32.5 3.31t-30.5 6.54v-160.93L408-540.31 158-717.46v355.15q0 5.39 3.46 8.85t8.85 3.46h319.54q-.23 1.5-.04 5t.19 9q0 7.5 1.62 19 1.61 11.5 2.84 19H170.31Zm26.53-456L408-602.69 619.93-754H196.84ZM158-350V-754v404Z"/>
    </svg>
  {% endcall %}

</span>
