  id="{{ id }}" class="desc-button {{ class }}"
  tabindex="0"
  viewBox="-12 -12 24 24"
  width="20px" height="20px"
  {% if onclick %}onclick="{{ onclick }}" onkeydown="(e) => console.log(e)"{% endif %}
  {% if target_modal %}data-bs-toggle="modal" data-bs-target="#{{ target_modal }}"{% endif %}
>
  <defs>
    <mask id="{{ id }}-mask-info">
      <rect x="-12" y="-12" width="100%" height="100%" fill="white"></rect>
      <text x="0" y="1" fill="black" alignment-baseline="middle" text-anchor="middle" font-size="14px" font-weight="bold" style="font-family: monospace;">i</text>
    </mask>
    <mask id="{{ id }}-mask-play">
      <rect x="-12" y="-12" width="100%" height="100%" fill="white"></rect>
      <polygon points="-3.08,-4.32 -3.08,4.32 5.4,0" fill="black"/>
    </mask>
    <mask id="{{ id }}-mask-pause">
      <rect x="-12" y="-12" width="100%" height="100%" fill="white"></rect>
      <rect width="2.25" height="9" x="-3.75" y="-4.5"></rect>
      <rect width="2.25" height="9" x="1.5"   y="-4.5"></rect>
