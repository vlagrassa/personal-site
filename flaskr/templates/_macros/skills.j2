{% from '_macros/utils.j2'    import render_content, render_hex_button %}



{%- macro render_proficiency_chart(elementId, scores, config) %}
<div id="{{ elemendId }}-tab-container" class="h-100 w-100" style="position: relative;">

  <div style="position: absolute; top: -4px; right: -8px; z-index: 20">
    {{ render_hex_button('proficiency-info-button', target_modal='help') }}
  </div>

  <div id="{{ elementId }}" class="h-100 w-100"></div>

  {# Overlay #}
  <div id="{{ elementId }}-overlay" class="proficiency-chart-overlay py-2 text-start">
    {# <button id="{{elementId}}-button-hide" class="btn badge btn-clear float-end">↶</button> #}
    {# <button id="{{elementId}}-button-hide" class="btn badge btn-clear float-end py-1">x</button> #}

    {# Text Content #}
    <div id="{{ elementId }}-overlay-content">
    {{ render_content(config, header_level=6) }}
    </div>

    {# Action buttons #}
    <button id="{{elementId}}-button-hide" class="btn badge btn-primary py-1">Back to Graph</button>
    <button id="{{elementId}}-button-link" class="btn badge btn-primary py-1">View Projects</button>
  </div>

</div>

<link rel="stylesheet" href="{{ url_for('static', filename='styles/proficiencies.css') }}">
<script type="module">
  import { graph_proficiencies } from "{{ url_for('static', filename='scripts/proficiencies.js') }}";

  // Get relevant elements
  const parent  = document.getElementById('{{ elementId }}')
  const overlay = document.getElementById('{{ elementId }}-overlay')
  const content = document.getElementById('{{ elementId }}-overlay-content')
  const btnHide = document.getElementById('{{ elementId }}-button-hide')
  const btnLink = document.getElementById('{{ elementId }}-button-link')

  let currentlySelected = null;

  // Show the overlay element
  const showOverlay = (selected) => {
    Array.from(content.children).forEach((el) => {
      el.classList.toggle('hide', el.dataset.section !== selected);
    })
    currentlySelected = selected;
    overlay.classList.add('active');
    parent.querySelectorAll(`.label-text`).forEach(el => el.tabIndex = -1)
    btnHide.focus();
  }

  // Hide the overlay element
  const hideOverlay = () => {
    overlay.classList.remove('active');
    parent.querySelectorAll(`.label-text`).forEach(el => el.tabIndex = 0)
    parent.querySelector(`.label-text[data-label-id=${currentlySelected}]`).focus()
  }

  if (btnHide) btnHide.onclick = hideOverlay

  const config = {
    'labels': [
      {%- for section in config %}
      { 'id': '{{ section.id }}', 'title': {{ section.head }} },
      {%- endfor %}
    ],
    'onClick': showOverlay,
    'initialLang': '{{ lang }}',
  }

  const data = {{ scores }};

  // Create the graph element
  const svg = graph_proficiencies(parent, data, config);

  // Add the graph
  parent.innerHTML = '';
  parent.append(svg.node());
</script>
{%- endmacro %}
